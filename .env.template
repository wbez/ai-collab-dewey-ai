# Azure OpenAI Configuration
# Required for embedding generation and AI capabilities
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
EMBEDDING_DEPLOYMENT_NAME="your-embedding-deployment-name"
EMBEDDING_MODEL_NAME="text-embedding-3-large"
CHATGPT_DEPLOYMENT_NAME="your-chatgpt-deployment-name"
CHATGPT_MODEL_NAME="gpt-5"


# Azure AI Search Configuration  
# Required for document indexing and search capabilities
AZURE_SEARCH_ENDPOINT="https://your-search-service.search.windows.net"
AZURE_SEARCH_API_KEY="your-azure-search-api-key"
AZURE_SEARCH_INDEX_NAME="your-search-index-name"

# Azure Blob Storage Configuration
# Required for document storage and indexer processing
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=your-storage-key;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="documents"

# Dewey Web App Configuration
GRADIO_SERVER_NAME="0.0.0.0"
GRADIO_SERVER_PORT="7860"

# Wavelength MCP / Slack Configuration
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"
SLACK_SIGNING_SECRET="your-slack-signing-secret"
WAVELENGTH_MCP_AUTH_TOKEN="replace-with-a-long-random-token"
WAVELENGTH_PUBLIC_BASE_URL="https://wavelength.example.com"
WAVELENGTH_STATE_DB="data/wavelength-state.sqlite3"
WAVELENGTH_DATA_DIR="data"
WAVELENGTH_RESPONSES_MCP_ENABLED="false"
WAVELENGTH_WORK_OBJECTS_ENABLED="false"
WAVELENGTH_ALLOWED_SLACK_TEAM_IDS=""
WAVELENGTH_ALLOWED_SLACK_USER_IDS=""
WAVELENGTH_SLASH_RESPONSE_TYPE="ephemeral"
WAVELENGTH_SKIP_SLACK_REQUEST_AUTH="false"
WAVELENGTH_HTTP_HOST="127.0.0.1"
WAVELENGTH_HTTP_PORT="8000"
WAVELENGTH_MCP_HOST="127.0.0.1"
WAVELENGTH_SKIP_MCP_AUTH="false"
